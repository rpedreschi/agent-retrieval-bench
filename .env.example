# Copy to .env and fill in. Never commit the populated file.

# --- Variant B engine selection -----------------------------------------------
# "local" runs the in-process reference oracle (used by make bench-laptop).
# "deltastream" runs the production backend that produces headline numbers.
ARB_CONTEXT_ENGINE=local

# --- DeltaStream credentials (only required when ARB_CONTEXT_ENGINE=deltastream)
ARB_DELTASTREAM_URL=
ARB_DELTASTREAM_TOKEN=
ARB_DELTASTREAM_DATABASE=

# --- Bearer tokens passed to MCP servers (variant-scoped) --------------------
# These match the token strings in config/variant_a.yaml and config/variant_b.yaml.
# The harness exports the appropriate one before launching each variant.
ARB_MCP_TOKEN=
